{
  "compilerOptions": {
    "target": "ES2022",
    // ES2023 for Array.prototype.findLastIndex, used by the change queue's collapsing logic.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // One program covers the app, the tests and the Node build script. `core/` is imported by both
    // the browser and scripts/build-data.ts, so splitting into referenced projects only creates
    // file-ownership conflicts for no benefit.
    "types": ["node", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
