{
  "table": "squares",
  "file": "data/squares.csv",
  "label": "Squares",
  "labelSingular": "Square",
  "icon": "grid",
  "idField": "id",
  "idPrefix": "S",
  "idPadding": 3,
  "titleField": "id",
  "subtitleField": "design_id",
  "goal": 400,
  "derivedFilters": [
    { "key": "source", "label": "Source", "via": "design_id", "throughField": "source" }
  ],
  "fields": [
    { "key": "id", "label": "ID", "type": "id", "list": true },
    { "key": "date", "label": "Date", "type": "date", "list": true, "defaultToday": true },
    {
      "key": "status",
      "label": "Status",
      "type": "enum",
      "options": ["planned", "in progress", "done", "blocked"],
      "default": "done",
      "list": true,
      "filter": true,
      "help": "Blocked comes after done: the square is crocheted and has also been blocked."
    },
    { "key": "design_id", "label": "Design", "type": "ref", "refTable": "designs", "list": true, "filter": true, "quickCreate": true, "searchFields": ["name", "source"] },
    { "key": "construction_type", "label": "Construction", "type": "enum", "options": ["solid", "holey"], "list": true, "inheritFrom": { "via": "design_id", "throughField": "construction_type" }, "help": "Leave blank to use the design's construction type." },
    { "key": "customization", "label": "Customization", "type": "textarea", "help": "How you deviated from the pattern." },
    { "key": "main_yarn", "label": "Main colour", "type": "ref", "refTable": "yarns", "list": true, "filter": true },
    { "key": "extra_yarns", "label": "Extra colours", "type": "reflist", "refTable": "yarns", "separator": ";", "list": true },
    { "key": "position", "label": "Position", "type": "text", "help": "Where it sits in the blanket. Free text for now." },
    { "key": "notes", "label": "Notes", "type": "textarea" }
  ]
}
